# TAKE A BASE IMAGE TO RUN THE PROJECT ON
FROM node:18


# SET A WORKING DIRECTORY WERE OUR APPLICATION FILE OUR KEPT
WORKDIR /app

# COPY ALL THE PACKAGE FILE
COPY package*.json .

# INSTALL THE REQUIRED DEPENDENCIES
RUN npm install

# COPY ALL THE REQUIRED FILE TO RUN OUR APPLICATION
COPY . .

# OPEN THE PORT ON WHICH THE APPLICATION  IS GOING TO RUN ON
EXPOSE 5000

# COMMAND THAT KEEPS THE CONTAIINER IN THE RUNNING STATE
CMD [ "node" , "index.js"]
